{
  "name": "droid-lite",
  "displayName": "Droid Lite",
  "description": "Android tools for VS Code and Cursor: test tools in the Test Explorer, Compose previews without Gradle, implementation links, Compose stability, device screenshot, screen recording and logcat.",
  "version": "0.5.1",
  "publisher": "forgebyte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/narayan07feb/droid-lite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionPack": [
    "GitHub.vscode-pull-request-github"
  ],
  "contributes": {
    "commands": [
      {
        "command": "droidLite.preview",
        "title": "Droid Lite: Compose Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "droidLite.screenshot",
        "title": "Droid Lite: Device Screenshot",
        "icon": "$(device-camera)"
      },
      {
        "command": "droidLite.recordStart",
        "title": "Droid Lite: Start Screen Recording",
        "icon": "$(record)"
      },
      {
        "command": "droidLite.recordStop",
        "title": "Droid Lite: Stop Screen Recording"
      },
      {
        "command": "droidLite.logcat",
        "title": "Droid Lite: Show Logcat",
        "icon": "$(output)"
      },
      {
        "command": "droidLite.logcatStop",
        "title": "Droid Lite: Stop Logcat"
      },
      {
        "command": "droidLite.reindex",
        "title": "Droid Lite: Index the Project Again"
      },
      {
        "command": "droidLite.menu",
        "title": "Droid Lite: Tools…"
      },
      {
        "command": "droidLite.addTestPlugin",
        "title": "Droid Lite: Add Test Plugin…",
        "icon": "$(add)"
      },
      {
        "command": "droidLite.removeTestPlugin",
        "title": "Droid Lite: Remove Test Plugin"
      },
      {
        "command": "droidLite.testAction",
        "title": "Droid Lite: Run Test Plugin Action"
      },
      {
        "command": "droidLite.stopTestAction",
        "title": "Droid Lite: Stop Test Plugin Action"
      },
      {
        "command": "droidLite.refreshTestView",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "droidLite.allowTestPlugin",
        "title": "Allow…"
      }
    ],
    "configuration": {
      "title": "Droid Lite",
      "properties": {
        "droidLite.enginePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the droid-lite binary. Empty: the one inside this extension."
        },
        "droidLite.logcatHistory": {
          "type": "number",
          "default": 500,
          "description": "Logcat lines to show from before the stream starts."
        },
        "droidLite.logcatMaxLines": {
          "type": "number",
          "default": 20000,
          "description": "Most logcat lines the Logcat output keeps; older lines are cleared."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "droidLite",
          "title": "Droid Lite",
          "icon": "media/droid.svg"
        }
      ]
    },
    "views": {
      "droidLite": [
        {
          "id": "droidLite.tools",
          "name": "Tools"
        },
        {
          "id": "droidLite.testPlugins",
          "name": "Test plugins"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "droidLite.preview",
          "when": "resourceExtname == .kt",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "droidLite.preview",
          "when": "view == droidLite.tools",
          "group": "navigation"
        },
        {
          "command": "droidLite.screenshot",
          "when": "view == droidLite.tools",
          "group": "navigation"
        },
        {
          "command": "droidLite.recordStart",
          "when": "view == droidLite.tools",
          "group": "navigation"
        },
        {
          "command": "droidLite.logcat",
          "when": "view == droidLite.tools",
          "group": "navigation"
        },
        {
          "command": "droidLite.addTestPlugin",
          "when": "view == droidLite.testPlugins",
          "group": "navigation"
        }
      ],
      "testing/item/context": [
        {
          "command": "droidLite.allowTestPlugin",
          "when": "controllerId == droidLite.tests && testId =~ /^needs-ok:/"
        }
      ],
      "view/item/context": [
        {
          "command": "droidLite.refreshTestView",
          "when": "view == droidLite.testPlugins && viewItem == droidLiteView",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "droidLite.removeTestPlugin",
          "when": "false"
        },
        {
          "command": "droidLite.testAction",
          "when": "false"
        },
        {
          "command": "droidLite.stopTestAction",
          "when": "false"
        },
        {
          "command": "droidLite.refreshTestView",
          "when": "false"
        },
        {
          "command": "droidLite.allowTestPlugin",
          "when": "false"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Droid Lite runs its engine and adb on your Mac."
    }
  },
  "icon": "media/icon.png"
}
